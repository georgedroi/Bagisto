[Unit]
Description=Man Secret Pleasure Laravel queue
After=network.target mysql.service
Requires=mysql.service

[Service]
Type=simple
User=www-data
Group=www-data
UMask=0002
WorkingDirectory=/var/www/mansecretpleasure/current
ExecStart=/usr/bin/php8.3 artisan queue:work database --queue=default,broadcastable --sleep=3 --tries=3 --timeout=60 --max-time=3600
Restart=always
RestartSec=5
TimeoutStopSec=180
KillSignal=SIGTERM
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/www/mansecretpleasure/shared/storage /var/www/mansecretpleasure/current/bootstrap/cache

[Install]
WantedBy=multi-user.target
