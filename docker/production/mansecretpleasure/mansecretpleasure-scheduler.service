[Unit]
Description=Man Secret Pleasure Laravel scheduler
After=network.target mysql.service
Requires=mysql.service

[Service]
Type=oneshot
User=www-data
Group=www-data
UMask=0002
WorkingDirectory=/var/www/mansecretpleasure/current
ExecStart=/usr/bin/php8.3 artisan schedule:run
TimeoutStartSec=1800
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/www/mansecretpleasure/shared/storage /var/www/mansecretpleasure/current/bootstrap/cache
